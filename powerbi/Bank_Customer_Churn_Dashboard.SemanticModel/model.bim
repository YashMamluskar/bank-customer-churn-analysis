            "sourceColumn": "Balance Band Order",
            "summarizeBy": "none"
          },
          {
            "name": "Customer Status",
            "dataType": "string",
            "expression": "IF(bank_customers[churn] = 1, \"Churned\", \"Retained\")",
            "isDataTypeInferred": true,
            "lineageTag": "5959df65-1402-407d-a222-25fc9a6fccd7",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Membership Status",
            "dataType": "string",
            "expression": "IF(bank_customers[active_member] = 1, \"Active\", \"Inactive\")",
            "isDataTypeInferred": true,
            "lineageTag": "e3971174-ee9c-48b9-b6cd-c6aa45d2d6e1",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Credit Card Status",
            "dataType": "string",
            "expression": "IF(bank_customers[credit_card] = 1, \"Has credit card\", \"No credit card\")",
            "isDataTypeInferred": true,
            "lineageTag": "e1cc220d-1b45-4280-b993-f171b0150012",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Products Held",
            "dataType": "string",
            "expression": "bank_customers[products_number] & IF(bank_customers[products_number] = 1, \" product\", \" products\")",
            "isDataTypeInferred": true,
            "lineageTag": "e5b9ff8d-6749-4530-bbe1-8787648f0b40",
            "sortByColumn": "products_number",
            "summarizeBy": "none",
            "type": "calculated"
          }
        ],
        "lineageTag": "6f603742-1479-4eec-b10b-c3d04351a1a4",
        "measures": [
          {
            "name": "Total Customers",
            "description": "Counts customer rows. Each row is one customer.",
            "expression": "COUNTROWS(bank_customers)",
            "formatString": "#,0",
            "lineageTag": "8572a065-1b24-43fa-849d-cbff4200d581"
          },
          {
            "name": "Churned Customers",
            "description": "Adds the churn column, where 1 means the customer left.",
            "expression": "SUM(bank_customers[churn])",
            "formatString": "#,0",
            "lineageTag": "6296f0e2-d624-429e-97d2-83c8705140a3"
          },
          {
            "name": "Retained Customers",
            "description": "Customers who did not leave.",
            "expression": "[Total Customers] - [Churned Customers]",
            "formatString": "#,0",
            "lineageTag": "5ba74739-5b38-48d3-acc9-7b3f776123a7"
          },
          {
            "name": "Churn Rate",
            "description": "Churned customers as a share of customers in the current selection.",
            "expression": "DIVIDE([Churned Customers], [Total Customers])",
            "formatString": "0.00%",
            "lineageTag": "9630c71d-47ab-4227-bbf2-a65a11cfdda3"
          },
          {
            "name": "Retention Rate",
            "description": "Retained customers as a share of customers in the current selection.",
            "expression": "DIVIDE([Retained Customers], [Total Customers])",
            "formatString": "0.00%",
            "lineageTag": "f3c77cbb-f661-42fa-8c74-9fcd0f80e77d"
          },
          {
            "name": "Churn Contribution %",
            "description": "Churned customers in the current selection as a share of all 2,037 churned customers. ALL ignores slicers for the denominator.",
            "expression": "DIVIDE([Churned Customers], CALCULATE([Churned Customers], ALL(bank_customers)))",
            "formatString": "0.00%",
            "lineageTag": "95f2ad71-8c02-4c46-8d07-78be3227b931"
          },
          {
            "name": "Total Customer Balance",
            "description": "Adds all account balances. This is not revenue or profit.",
            "expression": "SUM(bank_customers[balance])",
            "formatString": "#,0.00",
            "lineageTag": "f40f37d3-51c9-4d58-9939-f1dfbe1cc522"
          },
          {
            "name": "Churned Customer Balance",
            "description": "Adds balances held by churned customers. This is not lost revenue or profit.",
            "expression": "CALCULATE([Total Customer Balance], bank_customers[churn] = 1)",
            "formatString": "#,0.00",
            "lineageTag": "85a62d13-02a9-4352-952b-17738f392662"
          }
        ],
        "partitions": [
          {
            "name": "bank_customers",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(ProjectFolder & \"\\data\\processed\\bank_churn_cleaned.csv\"), [Delimiter = \",\", Columns = 17, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {{\"customer_id\", Int64.Type}, {\"credit_score\", Int64.Type}, {\"country\", type text}, {\"gender\", type text}, {\"age\", Int64.Type}, {\"tenure\", Int64.Type}, {\"balance\", Currency.Type}, {\"products_number\", Int64.Type}, {\"credit_card\", Int64.Type}, {\"active_member\", Int64.Type}, {\"estimated_salary\", Currency.Type}, {\"churn\", Int64.Type}, {\"age_group\", type text}, {\"tenure_group\", type text}, {\"credit_score_band\", type text}, {\"salary_band\", type text}, {\"balance_band\", type text}}, \"en-US\"),",
                "    AddedAgeGroupOrder = Table.AddColumn(ChangedTypes, \"Age Group Order\", each List.PositionOf({\"Under 30\", \"30 to 39\", \"40 to 49\", \"50 to 59\", \"60 and above\"}, [age_group]) + 1, Int64.Type),",
                "    AddedTenureGroupOrder = Table.AddColumn(AddedAgeGroupOrder, \"Tenure Group Order\", each List.PositionOf({\"0 to 2\", \"3 to 5\", \"6 to 8\", \"9 to 10\"}, [tenure_group]) + 1, Int64.Type),",
                "    AddedCreditScoreBandOrder = Table.AddColumn(AddedTenureGroupOrder, \"Credit Score Band Order\", each List.PositionOf({\"Below 580\", \"580 to 669\", \"670 to 739\", \"740 to 799\", \"800 and above\"}, [credit_score_band]) + 1, Int64.Type),",
                "    AddedSalaryBandOrder = Table.AddColumn(AddedCreditScoreBandOrder, \"Salary Band Order\", each List.PositionOf({\"Under 50,000\", \"50,000 to under 100,000\", \"100,000 to under 150,000\", \"150,000 and above\"}, [salary_band]) + 1, Int64.Type),",
                "    AddedBalanceBandOrder = Table.AddColumn(AddedSalaryBandOrder, \"Balance Band Order\", each List.PositionOf({\"Zero\", \"Above 0 to 100,000\", \"Above 100,000 to 150,000\", \"Above 150,000\"}, [balance_band]) + 1, Int64.Type)",
                "in",
                "    AddedBalanceBandOrder"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "Priority Segments",
        "columns": [
          {
            "name": "Segment",
            "dataType": "string",
            "isDataTypeInferred": true,
            "isNameInferred": true,
            "lineageTag": "307ee1c4-1c8e-4dbc-90fe-62ea790d510c",
            "sourceColumn": "[Segment]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          },
          {
            "name": "Customers",
            "dataType": "int64",
            "formatString": "#,0",
            "isDataTypeInferred": true,
            "isNameInferred": true,
            "lineageTag": "49ea74bf-e8d0-42e4-a0ac-f5b1f4a616b0",
            "sourceColumn": "[Customers]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          },
          {
            "name": "Churned",
            "dataType": "int64",
            "formatString": "#,0",
            "isDataTypeInferred": true,
            "isNameInferred": true,
            "lineageTag": "7344c6d1-b73d-4060-90fe-55b2b9478536",
            "sourceColumn": "[Churned]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          },
          {
            "name": "Churn Rate",
            "dataType": "double",
            "formatString": "0.00%",
            "isDataTypeInferred": true,
            "isNameInferred": true,
            "lineageTag": "5c50f232-8859-406d-84ee-a0a992e3c741",
            "sourceColumn": "[Churn Rate]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          },
          {
            "name": "Share of Total Churn",
            "dataType": "double",
            "formatString": "0.00%",
            "isDataTypeInferred": true,
            "isNameInferred": true,
            "lineageTag": "291e5bdd-992b-4e3e-85a3-e4362e229536",
            "sourceColumn": "[Share of Total Churn]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          }
        ],
        "lineageTag": "187137c6-33f6-44de-a8fc-d0810f8650c2",
        "partitions": [
          {
            "name": "Priority Segments",
            "mode": "import",
            "source": {
              "expression": [
                "ADDCOLUMNS(",
                "    UNION(",
                "        ROW(\"Segment\", \"Age 50 to 59 + Inactive\", \"Customers\", CALCULATE([Total Customers], bank_customers[age_group] = \"50 to 59\", bank_customers[active_member] = 0), \"Churned\", CALCULATE([Churned Customers], bank_customers[age_group] = \"50 to 59\", bank_customers[active_member] = 0)),",
                "        ROW(\"Segment\", \"Age 50 to 59 + 1 product\", \"Customers\", CALCULATE([Total Customers], bank_customers[age_group] = \"50 to 59\", bank_customers[products_number] = 1), \"Churned\", CALCULATE([Churned Customers], bank_customers[age_group] = \"50 to 59\", bank_customers[products_number] = 1)),",
                "        ROW(\"Segment\", \"Female + Age 50 to 59\", \"Customers\", CALCULATE([Total Customers], bank_customers[gender] = \"Female\", bank_customers[age_group] = \"50 to 59\"), \"Churned\", CALCULATE([Churned Customers], bank_customers[gender] = \"Female\", bank_customers[age_group] = \"50 to 59\")),",
                "        ROW(\"Segment\", \"Age 50 to 59 + Balance above 100,000 to 150,000\", \"Customers\", CALCULATE([Total Customers], bank_customers[age_group] = \"50 to 59\", bank_customers[balance_band] = \"Above 100,000 to 150,000\"), \"Churned\", CALCULATE([Churned Customers], bank_customers[age_group] = \"50 to 59\", bank_customers[balance_band] = \"Above 100,000 to 150,000\")),",
                "        ROW(\"Segment\", \"Male + Age 50 to 59\", \"Customers\", CALCULATE([Total Customers], bank_customers[gender] = \"Male\", bank_customers[age_group] = \"50 to 59\"), \"Churned\", CALCULATE([Churned Customers], bank_customers[gender] = \"Male\", bank_customers[age_group] = \"50 to 59\")),",
                "        ROW(\"Segment\", \"Germany + Age 40 to 49\", \"Customers\", CALCULATE([Total Customers], bank_customers[country] = \"Germany\", bank_customers[age_group] = \"40 to 49\"), \"Churned\", CALCULATE([Churned Customers], bank_customers[country] = \"Germany\", bank_customers[age_group] = \"40 to 49\")),",
                "        ROW(\"Segment\", \"Germany + 1 product\", \"Customers\", CALCULATE([Total Customers], bank_customers[country] = \"Germany\", bank_customers[products_number] = 1), \"Churned\", CALCULATE([Churned Customers], bank_customers[country] = \"Germany\", bank_customers[products_number] = 1)),",
                "        ROW(\"Segment\", \"Germany + Inactive\", \"Customers\", CALCULATE([Total Customers], bank_customers[country] = \"Germany\", bank_customers[active_member] = 0), \"Churned\", CALCULATE([Churned Customers], bank_customers[country] = \"Germany\", bank_customers[active_member] = 0))",
                "    ),",
                "    \"Churn Rate\", DIVIDE([Churned], [Customers]),",
                "    \"Share of Total Churn\", DIVIDE([Churned], CALCULATE([Churned Customers], ALL(bank_customers)))",
                ")"
              ],
              "type": "calculated"
            }
          }
        ]
      }
    ]
  }
}